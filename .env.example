# Backend
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://clinicavida:clinicavida_dev@localhost:5432/clinicavida?schema=public

# JWT — access token
# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=change-me-in-prod-min-32-chars-long
JWT_EXPIRES_IN=15m            # recomendado 15 min para access token

# JWT — refresh token (segredo separado do access token)
# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d     # 7 dias

# Rate limit / lockout
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Log
LOG_LEVEL=info

# CORS — lista CSV de origens permitidas (ex.: http://localhost:5173,https://app.clinicavida.com.br)
CORS_ORIGIN=http://localhost:3000

# Bot integração n8n (Sprint 4 — endpoint /bot/* protegido por x-bot-secret)
BOT_SECRET=change-me-bot-shared-secret

# Painel TV (Sprint 6 — endpoint /recepcao/painel-tv protegido por x-tv-token)
# Mínimo 16 caracteres. Gere com: openssl rand -base64 24
TV_SECRET=change-me-tv-shared-secret-min-16

# WhatsApp via n8n + Evolution API
N8N_WEBHOOK_URL=http://localhost:5678/webhook/clinicavida-whatsapp
N8N_TIMEOUT_MS=10000
WA_MAX_TENTATIVAS=3
WA_CONFIRMACAO_HORAS=24
WA_LEMBRETE_HORAS=2
WA_LIMITE_AUTO_HORAS=2
WA_ENABLED=true
WA_DRY_RUN=true
# Allowlist rollout gradual (só dígitos, vírgula). Vazio = sem restrição.
WA_ALLOWLIST=

# Seed — apenas dev/homolog, NÃO usar em prod
# Sobrescreve os defaults do seed.ts. Omitir = usar fallback hard-coded.
# SEED_ADMIN_EMAIL=admin@clinicavida.local
# SEED_ADMIN_PASSWORD=Admin@2026!
# SEED_RECEPCAO_EMAIL=recepcao@clinicavida.local
# SEED_RECEPCAO_PASSWORD=Recepcao@2026!
# SEED_MEDICO_EMAIL=medico@clinicavida.local
# SEED_MEDICO_PASSWORD=Medico@2026!
# SEED_PROFISSIONAL_EMAIL=profissional@clinicavida.local
# SEED_PROFISSIONAL_PASSWORD=Profissional@2026!

# Frontend
VITE_API_URL=http://localhost:3000
