# .env.homolog.example
# Copie para .env.homolog (NÃO commitar!) e preencha os secrets.
# Gere secrets fortes com: node scripts/gen-secrets.mjs

# ---------- Banco ----------
POSTGRES_USER=clinicavida
POSTGRES_PASSWORD=GERAR_SENHA_FORTE_32_CHARS
POSTGRES_DB=clinicavida

# ---------- Domínio + CORS ----------
# Use o domínio HTTPS público — sem trailing slash
CORS_ORIGIN=https://homolog.clinicavida.cloud

# ---------- JWT ----------
# ≥32 chars cada (use scripts/gen-secrets.mjs)
JWT_SECRET=GERAR_64_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=GERAR_64_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Auth bruteforce ----------
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ---------- Logs ----------
LOG_LEVEL=info

# ---------- Bot WhatsApp / Painel TV ----------
# ≥16 chars cada
BOT_SECRET=GERAR_32_CHARS
TV_SECRET=GERAR_32_CHARS

# ---------- n8n + Evolution API ----------
# URL do webhook do workflow n8n que recebe envio outbound
N8N_WEBHOOK_URL=https://n8n.exemplo.com/webhook/clinicavida-outbound
N8N_TIMEOUT_MS=10000

# ---------- WhatsApp behavior ----------
# Rollout gradual (ver docs/runbook-whatsapp.md):
#  Fase 1: WA_DRY_RUN=true → loga payload, não envia nada
#  Fase 2: WA_DRY_RUN=false + WA_ALLOWLIST=<números equipe> → só equipe recebe real
#  Fase 3: WA_DRY_RUN=false + WA_ALLOWLIST vazio → produção plena
WA_ENABLED=true
WA_DRY_RUN=true
# Allowlist de números (só dígitos, separados por vírgula). Casa por sufixo,
# então pode incluir DDI ou não. Vazio = sem restrição.
# Ex.: WA_ALLOWLIST=5566999990001,66999990002
WA_ALLOWLIST=
WA_MAX_TENTATIVAS=3
WA_CONFIRMACAO_HORAS=24
WA_LEMBRETE_HORAS=2
WA_LIMITE_AUTO_HORAS=2
