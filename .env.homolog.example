# .env.homolog.example
# Copie para .env.homolog (NÃO commitar!) e preencha os secrets.
# Gere secrets fortes com: node scripts/gen-secrets.mjs

# ---------- Banco ----------
POSTGRES_USER=clinicavida
POSTGRES_PASSWORD=GERAR_SENHA_FORTE_32_CHARS
POSTGRES_DB=clinicavida

# ---------- Domínio + CORS ----------
# Use o domínio HTTPS público — sem trailing slash
CORS_ORIGIN=https://homolog.clinicavida.cloud

# ---------- JWT ----------
# ≥32 chars cada (use scripts/gen-secrets.mjs)
JWT_SECRET=GERAR_64_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=GERAR_64_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Auth bruteforce ----------
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ---------- Logs ----------
LOG_LEVEL=info

# ---------- Bot WhatsApp / Painel TV ----------
# ≥16 chars cada
BOT_SECRET=GERAR_32_CHARS
TV_SECRET=GERAR_32_CHARS

# ---------- n8n + Evolution API ----------
# URL do webhook do workflow n8n que recebe envio outbound
N8N_WEBHOOK_URL=https://n8n.exemplo.com/webhook/clinicavida-outbound
N8N_TIMEOUT_MS=10000

# ---------- WhatsApp behavior ----------
# Em primeira subida: WA_ENABLED=true + WA_DRY_RUN=true (loga sem enviar)
# Após validar logs: WA_DRY_RUN=false
WA_ENABLED=true
WA_DRY_RUN=true
WA_MAX_TENTATIVAS=3
WA_CONFIRMACAO_HORAS=24
WA_LEMBRETE_HORAS=2
WA_LIMITE_AUTO_HORAS=2
