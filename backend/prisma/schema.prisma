generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                   String            @id @default(uuid()) @db.Uuid
  email                String            @unique
  senhaHash            String            @map("senha_hash")
  nomeCompleto         String            @map("nome_completo")
  perfil               PerfilTipo
  ativo                Boolean           @default(true)
  tentativasLogin      Int               @default(0) @map("tentativas_login")
  bloqueadoAte         DateTime?         @map("bloqueado_ate")
  ultimoLoginEm        DateTime?         @map("ultimo_login_em")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  auditorias           Auditoria[]
  refreshTokens        RefreshToken[]
  evolucoes            Evolucao[]
  documentos           DocumentoMedico[]
  sugestoesIaAutor     SugestaoIA[]      @relation("SugestaoAutor")
  sugestoesIaAprovadas SugestaoIA[]      @relation("SugestaoAprovador")

  @@map("usuarios")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by") @db.Uuid
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Paciente {
  id                 String              @id @default(uuid()) @db.Uuid
  cpf                String              @unique @db.VarChar(11)
  nomeCompleto       String              @map("nome_completo")
  dataNascimento     DateTime            @map("data_nascimento") @db.Date
  sexo               Sexo                @default(NAO_INFORMADO)
  telefoneWhatsapp   String              @map("telefone_whatsapp") @db.VarChar(20)
  telefoneSecundario String?             @map("telefone_secundario") @db.VarChar(20)
  email              String?             @db.VarChar(255)
  responsavelNome    String?             @map("responsavel_nome")
  responsavelCpf     String?             @map("responsavel_cpf") @db.VarChar(11)
  endereco           Json?
  observacoes        String?
  criadoPor          String?             @map("criado_por") @db.Uuid
  atualizadoPor      String?             @map("atualizado_por") @db.Uuid
  deletedAt          DateTime?           @map("deleted_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  agendamentos       Agendamento[]
  listaEspera        ListaEspera[]
  mensagens          MensagemWhatsapp[]
  historico          PacienteHistorico[]
  prontuario         Prontuario?
  documentos         DocumentoMedico[]
  sugestoesIa        SugestaoIA[]

  @@index([nomeCompleto])
  @@index([telefoneWhatsapp])
  @@index([deletedAt])
  @@map("pacientes")
}

model Profissional {
  id               String           @id @default(uuid()) @db.Uuid
  nomeCompleto     String           @map("nome_completo")
  especialidade    String?
  registroConselho String?          @map("registro_conselho")
  ehMedico         Boolean          @default(false) @map("eh_medico")
  ativo            Boolean          @default(true)
  usuarioId        String?          @unique @map("usuario_id") @db.Uuid
  cor              String?          @db.VarChar(7)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  agendamentos     Agendamento[]
  bloqueios        BloqueioAgenda[]
  listaEspera      ListaEspera[]

  @@index([ativo])
  @@map("profissionais")
}

model ListaEspera {
  id               String            @id @default(uuid()) @db.Uuid
  pacienteId       String            @map("paciente_id") @db.Uuid
  profissionalId   String?           @map("profissional_id") @db.Uuid
  especialidade    String?
  prioridade       Int               @default(0)
  melhoresHorarios Json?             @map("melhores_horarios")
  observacoes      String?
  status           ListaEsperaStatus @default(ATIVO)
  ultimaOfertaEm   DateTime?         @map("ultima_oferta_em")
  ultimaRespostaEm DateTime?         @map("ultima_resposta_em")
  motivoRecusa     String?           @map("motivo_recusa")
  criadoPor        String?           @map("criado_por") @db.Uuid
  updatedAt        DateTime          @updatedAt @map("updated_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  paciente         Paciente          @relation(fields: [pacienteId], references: [id])
  profissional     Profissional?     @relation(fields: [profissionalId], references: [id])

  @@index([status, prioridade, createdAt])
  @@index([pacienteId, status])
  @@map("lista_espera")
}

model Agendamento {
  id                 String                 @id @default(uuid()) @db.Uuid
  pacienteId         String                 @map("paciente_id") @db.Uuid
  profissionalId     String                 @map("profissional_id") @db.Uuid
  dataHoraInicio     DateTime               @map("data_hora_inicio")
  dataHoraFim        DateTime               @map("data_hora_fim")
  tipo               TipoAtendimento        @default(CONSULTA)
  status             AgendamentoStatus
  origem             AgendamentoOrigem
  encaixe            Boolean                @default(false)
  observacoes        String?
  motivoCancelamento String?                @map("motivo_cancelamento")
  eventId            String?                @unique @map("event_id")
  criadoPor          String?                @map("criado_por") @db.Uuid
  atualizadoPor      String?                @map("atualizado_por") @db.Uuid
  confirmadoEm       DateTime?              @map("confirmado_em")
  canceladoEm        DateTime?              @map("cancelado_em")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  paciente           Paciente               @relation(fields: [pacienteId], references: [id])
  profissional       Profissional           @relation(fields: [profissionalId], references: [id])
  historico          AgendamentoHistorico[]
  mensagens          MensagemWhatsapp[]
  evolucoes          Evolucao[]
  documentos         DocumentoMedico[]
  sugestoesIa        SugestaoIA[]

  @@index([profissionalId, dataHoraInicio])
  @@index([pacienteId, dataHoraInicio])
  @@index([status])
  @@index([dataHoraInicio])
  @@index([origem])
  @@map("agendamentos")
}

model AgendamentoHistorico {
  id             String             @id @default(uuid()) @db.Uuid
  agendamentoId  String             @map("agendamento_id") @db.Uuid
  usuarioId      String?            @map("usuario_id") @db.Uuid
  acao           String
  statusAnterior AgendamentoStatus? @map("status_anterior")
  statusNovo     AgendamentoStatus? @map("status_novo")
  diff           Json
  traceId        String             @map("trace_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  agendamento    Agendamento        @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@index([agendamentoId, createdAt])
  @@map("agendamentos_historico")
}

model MensagemWhatsapp {
  id             String          @id @default(uuid()) @db.Uuid
  pacienteId     String?         @map("paciente_id") @db.Uuid
  agendamentoId  String?         @map("agendamento_id") @db.Uuid
  telefone       String          @db.VarChar(20)
  direcao        MensagemDirecao @default(OUTBOUND)
  tipo           MensagemTipo
  status         MensagemStatus  @default(PENDENTE)
  tentativas     Int             @default(0)
  proximoRetryEm DateTime?       @map("proximo_retry_em")
  payload        Json
  resposta       String?
  erro           String?
  eventId        String          @unique @map("event_id")
  providerMsgId  String?         @map("provider_msg_id")
  enviadaEm      DateTime?       @map("enviada_em")
  entregueEm     DateTime?       @map("entregue_em")
  respondidaEm   DateTime?       @map("respondida_em")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  agendamento    Agendamento?    @relation(fields: [agendamentoId], references: [id])
  paciente       Paciente?       @relation(fields: [pacienteId], references: [id])

  @@index([status, proximoRetryEm])
  @@index([pacienteId, createdAt])
  @@index([agendamentoId])
  @@map("mensagens_whatsapp")
}

model BloqueioAgenda {
  id             String       @id @default(uuid()) @db.Uuid
  profissionalId String       @map("profissional_id") @db.Uuid
  dataHoraInicio DateTime     @map("data_hora_inicio")
  dataHoraFim    DateTime     @map("data_hora_fim")
  motivo         String?
  criadoPor      String?      @map("criado_por") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([profissionalId, dataHoraInicio])
  @@map("bloqueios_agenda")
}

model PacienteHistorico {
  id         String   @id @default(uuid()) @db.Uuid
  pacienteId String   @map("paciente_id") @db.Uuid
  usuarioId  String?  @map("usuario_id") @db.Uuid
  acao       String
  diff       Json
  traceId    String   @map("trace_id")
  createdAt  DateTime @default(now()) @map("created_at")
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId, createdAt])
  @@map("pacientes_historico")
}

model Auditoria {
  id            String         @id @default(uuid()) @db.Uuid
  usuarioId     String?        @map("usuario_id") @db.Uuid
  acao          String
  entidade      String
  registroId    String?        @map("registro_id")
  dataHora      DateTime       @default(now()) @map("data_hora")
  ipDispositivo String?        @map("ip_dispositivo")
  resultado     AuditResultado
  traceId       String         @map("trace_id")
  detalhes      Json?
  usuario       Usuario?       @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([entidade, registroId])
  @@index([dataHora])
  @@index([traceId])
  @@map("auditoria")
}

model ConfiguracaoClinica {
  id                 String   @id @default(uuid()) @db.Uuid
  nomeClinica        String   @default("Clínica Vida Popular") @map("nome_clinica")
  horaAbertura       String   @default("07:00") @map("hora_abertura") @db.VarChar(5)
  horaFechamento     String   @default("19:00") @map("hora_fechamento") @db.VarChar(5)
  diasFuncionamento  Int[]    @default([1, 2, 3, 4, 5, 6]) @map("dias_funcionamento")
  duracaoConsultaMin Int      @default(30) @map("duracao_consulta_min")
  intervaloAlmocoIni String?  @map("intervalo_almoco_ini") @db.VarChar(5)
  intervaloAlmocoFim String?  @map("intervalo_almoco_fim") @db.VarChar(5)
  timezone           String   @default("America/Cuiaba")
  updatedAt          DateTime @updatedAt @map("updated_at")
  atualizadoPor      String?  @map("atualizado_por") @db.Uuid

  @@map("configuracoes_clinica")
}

enum PerfilTipo {
  ADMIN
  RECEPCAO
  MEDICO
  PROFISSIONAL_NAO_MEDICO
}

enum AuditResultado {
  SUCESSO
  FALHA
  NEGADO
}

enum Sexo {
  MASCULINO
  FEMININO
  OUTRO
  NAO_INFORMADO
}

enum AgendamentoStatus {
  SOLICITADO
  PRE_AGENDAMENTO
  CONFIRMADO
  CONFIRMACAO_TARDIA
  AGUARDANDO
  EM_ATENDIMENTO
  ATENDIDO
  FALTOU
  CANCELADO
}

enum AgendamentoOrigem {
  RECEPCAO
  ADMIN
  BOT_WHATSAPP
  PACIENTE_WHATSAPP
}

enum TipoAtendimento {
  CONSULTA
  RETORNO
  EXAME
  PROCEDIMENTO
  OUTRO
}

enum MensagemTipo {
  CONFIRMACAO_24H
  LEMBRETE_2H
  CONFIRMACAO_TARDIA
  CANCELAMENTO
  REMARCACAO
  VAGA_LIBERADA
  CUSTOM
}

enum MensagemStatus {
  PENDENTE
  ENVIADA
  ENTREGUE
  RESPONDIDA
  FALHA
  CANCELADA
}

enum MensagemDirecao {
  OUTBOUND
  INBOUND
}

enum ListaEsperaStatus {
  ATIVO
  CONTATADO
  RECUSADO
  AGENDADO
  CANCELADO
}

model Prontuario {
  id         String     @id @default(uuid()) @db.Uuid
  pacienteId String     @unique @map("paciente_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  paciente   Paciente   @relation(fields: [pacienteId], references: [id])
  evolucoes  Evolucao[]

  @@map("prontuarios")
}

model Evolucao {
  id              String   @id @default(uuid()) @db.Uuid
  prontuarioId    String   @map("prontuario_id") @db.Uuid
  agendamentoId   String   @map("agendamento_id") @db.Uuid
  autorUsuarioId  String   @map("autor_usuario_id") @db.Uuid
  autorEhMedico   Boolean  @map("autor_eh_medico")
  queixaPrincipal String?  @map("queixa_principal")
  subjetivo       String
  objetivo        String
  avaliacao       String
  plano           String
  versao          Int      @default(1)
  replacesId      String?  @unique @map("replaces_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  prontuario  Prontuario  @relation(fields: [prontuarioId], references: [id])
  agendamento Agendamento @relation(fields: [agendamentoId], references: [id])
  autor       Usuario     @relation(fields: [autorUsuarioId], references: [id])
  replaces    Evolucao?   @relation("Retificacao", fields: [replacesId], references: [id])
  replacedBy  Evolucao?   @relation("Retificacao")
  sugestaoIa  SugestaoIA?

  @@index([prontuarioId, createdAt])
  @@index([autorUsuarioId])
  @@map("evolucoes")
}

enum TipoSugestaoIA {
  RESUMO
  HIPOTESE
  CONDUTA
  ORIENTACOES
}

enum StatusSugestaoIA {
  GERADA
  APROVADA
  REJEITADA
  FALHA
}

model SugestaoIA {
  id                   String           @id @default(uuid()) @db.Uuid
  pacienteId           String           @map("paciente_id") @db.Uuid
  agendamentoId        String?          @map("agendamento_id") @db.Uuid
  evolucaoId           String?          @unique @map("evolucao_id") @db.Uuid
  tipo                 TipoSugestaoIA
  status               StatusSugestaoIA @default(GERADA)
  provider             String?
  modelo               String?
  promptVersao         String?          @map("prompt_versao")
  conteudoGerado       String?          @map("conteudo_gerado")
  conteudoAprovado     String?          @map("conteudo_aprovado")
  tokensPrompt         Int?             @map("tokens_prompt")
  tokensResposta       Int?             @map("tokens_resposta")
  erroMensagem         String?          @map("erro_mensagem")
  autorUsuarioId       String           @map("autor_usuario_id") @db.Uuid
  aprovadoPorUsuarioId String?          @map("aprovado_por_usuario_id") @db.Uuid
  aprovadoEm           DateTime?        @map("aprovado_em")
  createdAt            DateTime         @default(now()) @map("created_at")

  paciente    Paciente     @relation(fields: [pacienteId], references: [id])
  agendamento Agendamento? @relation(fields: [agendamentoId], references: [id])
  evolucao    Evolucao?    @relation(fields: [evolucaoId], references: [id])
  autor       Usuario      @relation("SugestaoAutor", fields: [autorUsuarioId], references: [id])
  aprovadoPor Usuario?     @relation("SugestaoAprovador", fields: [aprovadoPorUsuarioId], references: [id])

  @@index([pacienteId, createdAt])
  @@index([autorUsuarioId])
  @@map("sugestoes_ia")
}

enum TipoDocumento {
  RECEITA
  ATESTADO
  PEDIDO_EXAME
  ORIENTACOES
}

model DocumentoMedico {
  id             String        @id @default(uuid()) @db.Uuid
  pacienteId     String        @map("paciente_id") @db.Uuid
  autorUsuarioId String        @map("autor_usuario_id") @db.Uuid
  autorEhMedico  Boolean       @map("autor_eh_medico")
  agendamentoId  String?       @map("agendamento_id") @db.Uuid
  tipo           TipoDocumento
  conteudo       Json
  pdf            Bytes
  createdAt      DateTime      @default(now()) @map("created_at")

  paciente    Paciente     @relation(fields: [pacienteId], references: [id])
  autor       Usuario      @relation(fields: [autorUsuarioId], references: [id])
  agendamento Agendamento? @relation(fields: [agendamentoId], references: [id])

  @@index([pacienteId, createdAt])
  @@index([autorUsuarioId])
  @@map("documentos_medicos")
}
